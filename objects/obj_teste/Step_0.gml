resultado = " ";

if room_previous(air3)
{
	switch (global.r)
	{
		
	case 1:
	resultado = "#283fd7";
	case 2:
	resultado = "#fe6d6d7";
	case 3:
	resultado = "61354d";
	case 4:
	resultado = "#c0c0c0";
 
	}
}

if room_previous(terra1)
{
	switch (global.r) 
{
	case 1:
	resultado = "0101";
	case 2:
	resultado = "1010";
	case 3:
	resultado = "1100";
	case 4:
	resultado = "0001";
 
}

}