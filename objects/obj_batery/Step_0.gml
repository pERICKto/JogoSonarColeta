if (room == rm_minigame)
{
    instance_deactivate_object(obj_batery); // desliga Step e colisões também
} 

else
{

    instance_activate_object(obj_batery);
	}



consumo = obj_camera.pcr

if (instance_exists(obj_Sonar_player)) {
    batery -= consumo/20	//divite p or 100, pq o pcr geralmente eh 100
}
